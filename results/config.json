{
    "project": "Molecular Property Prediction using Graph Neural Networks",
    "dataset": "ESOL",
    "target": "Aqueous solubility (logS)",
    "dataset_size": 1128,
    "scaffold_split": {
        "train": 902,
        "validation": 113,
